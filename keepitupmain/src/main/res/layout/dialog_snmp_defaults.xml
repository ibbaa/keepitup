<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollview_dialog_snmp_defaults"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <LinearLayout
        android:id="@+id/linearlayout_dialog_snmp_defaults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/linearlayout_dialog_snmp_defaults_padding"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_title_margin_left"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_title_margin_top"
            android:layout_marginBottom="@dimen/linearlayout_dialog_snmp_defaults_title_margin_bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:text="@string/label_dialog_snmp_defaults_title" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_snmp_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_snmp_version_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_snmp_defaults_snmp_version_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_snmp_version_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_snmp_version_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_snmp_defaults_snmp_version" />

            <RadioGroup
                android:id="@+id/radiogroup_dialog_snmp_defaults_snmp_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:ignore="UselessParent">

                <RadioButton
                    android:id="@+id/radiobutton_dialog_snmp_defaults_snmp_version_v1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/radiobutton_dialog_snmp_defaults_padding_top"
                    android:paddingBottom="@dimen/radiobutton_dialog_snmp_defaults_padding_bottom"
                    android:minHeight="@dimen/radiobutton_dialog_snmp_defaults_min_height"
                    android:text="@string/SNMPVersion_V1_name" />

                <RadioButton
                    android:id="@+id/radiobutton_dialog_snmp_defaults_snmp_version_v2c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/radiobutton_dialog_snmp_defaults_padding_top"
                    android:paddingBottom="@dimen/radiobutton_dialog_snmp_defaults_padding_bottom"
                    android:minHeight="@dimen/radiobutton_dialog_snmp_defaults_min_height"
                    android:text="@string/SNMPVersion_V2C_name" />

                <RadioButton
                    android:id="@+id/radiobutton_dialog_snmp_defaults_snmp_version_v3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/radiobutton_dialog_snmp_defaults_padding_top"
                    android:paddingBottom="@dimen/radiobutton_dialog_snmp_defaults_padding_bottom"
                    android:minHeight="@dimen/radiobutton_dialog_snmp_defaults_min_height"
                    android:text="@string/SNMPVersion_V3_name" />

            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_snmp_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_snmp_port_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_snmp_defaults_snmp_port_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_snmp_port_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_snmp_port_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:labelFor="@id/edittext_dialog_snmp_defaults_snmp_port"
                android:text="@string/label_dialog_snmp_defaults_snmp_port" />

            <EditText
                android:id="@+id/edittext_dialog_snmp_defaults_snmp_port"
                style="@style/EditTextTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="@integer/edittext_dialog_snmp_defaults_snmp_port_max_length"
                android:text=""
                tools:ignore="LabelFor" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_snmp_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_snmp_transport_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_snmp_defaults_snmp_transport_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_snmp_transport_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_snmp_transport_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_snmp_defaults_snmp_transport" />

            <RadioGroup
                android:id="@+id/radiogroup_dialog_snmp_defaults_snmp_transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:ignore="UselessParent">

                <RadioButton
                    android:id="@+id/radiobutton_dialog_snmp_defaults_snmp_transport_udp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/radiobutton_dialog_snmp_defaults_padding_top"
                    android:paddingBottom="@dimen/radiobutton_dialog_snmp_defaults_padding_bottom"
                    android:minHeight="@dimen/radiobutton_dialog_snmp_defaults_min_height"
                    android:text="@string/SNMPTransport_UDP_name" />

                <RadioButton
                    android:id="@+id/radiobutton_dialog_snmp_defaults_snmp_transport_tcp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/radiobutton_dialog_snmp_defaults_padding_top"
                    android:paddingBottom="@dimen/radiobutton_dialog_snmp_defaults_padding_bottom"
                    android:minHeight="@dimen/radiobutton_dialog_snmp_defaults_min_height"
                    android:text="@string/SNMPTransport_TCP_name" />

            </RadioGroup>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_snmp_auth_algorithm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_snmp_auth_algorithm_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_snmp_defaults_snmp_auth_algorithm_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_snmp_auth_algorithm_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_snmp_auth_algorithm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_snmp_defaults_snmp_auth_algorithm" />

            <Spinner
                android:id="@+id/spinner_dialog_snmp_defaults_snmp_auth_algorithm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spinner_dialog_snmp_defaults_margin_top" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_snmp_priv_algorithm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_snmp_defaults_snmp_priv_algorithm_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_snmp_defaults_snmp_priv_algorithm_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_snmp_defaults_snmp_priv_algorithm_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_snmp_defaults_snmp_priv_algorithm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_snmp_defaults_snmp_priv_algorithm" />

            <Spinner
                android:id="@+id/spinner_dialog_snmp_defaults_snmp_priv_algorithm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spinner_dialog_snmp_defaults_margin_top" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_snmp_defaults_ok_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/linearlayout_dialog_snmp_defaults_ok_cancel_padding_top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageview_dialog_snmp_defaults_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/label_dialog_snmp_defaults_ok"
                app:srcCompat="@drawable/icon_ok_selector" />

            <ImageView
                android:id="@+id/imageview_dialog_snmp_defaults_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/label_dialog_snmp_defaults_cancel"
                app:srcCompat="@drawable/icon_cancel_selector" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
