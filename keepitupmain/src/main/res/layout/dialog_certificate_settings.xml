<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollview_dialog_certificate_settings"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <LinearLayout
        android:id="@+id/linearlayout_dialog_certificate_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/linearlayout_dialog_certificate_settings_padding"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearlayout_dialog_certificate_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_certificate_settings_title_margin_left"
            android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_title_margin_top"
            android:layout_marginBottom="@dimen/linearlayout_dialog_certificate_settings_title_margin_bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_certificate_settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:text="@string/label_dialog_certificate_settings_title" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_certificate_settings_ignore_ssl_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_certificate_settings_ignore_ssl_error_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_certificate_settings_ignore_ssl_error_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_ignore_ssl_error_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_certificate_settings_ignore_ssl_error_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_certificate_settings_ignore_ssl_error" />

            <LinearLayout
                android:id="@+id/linearlayout_dialog_certificate_settings_ignore_ssl_error_onoff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_ignore_ssl_error_onoff_margin_top"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dialog_certificate_settings_ignore_ssl_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/switch_dialog_certificate_settings_padding_top"
                    android:paddingBottom="@dimen/switch_dialog_certificate_settings_padding_bottom"
                    android:minHeight="@dimen/switch_dialog_certificate_settings_min_height"
                    app:trackTint="@drawable/switchtrack_selector"
                    app:thumbTint="@drawable/switchthumb_selector"
                    android:showText="false" />

                <TextView
                    android:id="@+id/textview_dialog_certificate_settings_ignore_ssl_error_on_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textStyle="bold"
                    android:text="" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_certificate_settings_failure_on_certificate_expiry_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/label_dialog_certificate_settings_failure_on_certificate_expiry" />

            <LinearLayout
                android:id="@+id/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry_onoff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_failure_on_certificate_expiry_onoff_margin_top"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dialog_certificate_settings_failure_on_certificate_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/switch_dialog_certificate_settings_padding_top"
                    android:paddingBottom="@dimen/switch_dialog_certificate_settings_padding_bottom"
                    android:minHeight="@dimen/switch_dialog_certificate_settings_min_height"
                    app:trackTint="@drawable/switchtrack_selector"
                    app:thumbTint="@drawable/switchthumb_selector"
                    android:showText="false" />

                <TextView
                    android:id="@+id/textview_dialog_certificate_settings_failure_on_certificate_expiry_on_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textStyle="bold"
                    android:text="" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_certificate_settings_expiry_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/linearlayout_dialog_certificate_settings_expiry_days_margin_left"
            android:layout_marginEnd="@dimen/linearlayout_dialog_certificate_settings_expiry_days_margin_end"
            android:layout_marginTop="@dimen/linearlayout_dialog_certificate_settings_expiry_days_margin_top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_dialog_certificate_settings_expiry_days_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:labelFor="@id/edittext_dialog_certificate_settings_expiry_days"
                android:text="@string/label_dialog_certificate_settings_expiry_days" />

            <EditText
                android:id="@+id/edittext_dialog_certificate_settings_expiry_days"
                style="@style/EditTextTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="@integer/edittext_dialog_certificate_settings_expiry_days_max_length"
                android:text=""
                tools:ignore="LabelFor" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout_dialog_certificate_settings_ok_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/linearlayout_dialog_certificate_settings_ok_cancel_padding_top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageview_dialog_certificate_settings_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/label_dialog_certificate_settings_ok"
                app:srcCompat="@drawable/icon_ok_selector" />

            <ImageView
                android:id="@+id/imageview_dialog_certificate_settings_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/label_dialog_certificate_settings_cancel"
                app:srcCompat="@drawable/icon_cancel_selector" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
